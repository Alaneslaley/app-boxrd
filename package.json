    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand src/core",
    "test:components": "jest --runInBand src/shared src/features",
    "doctor": "npx expo-doctor",
    "eas": "npx --yes --package eas-cli@21.2.0 --package typescript@6.0.3 eas",
    "generate:api": "node scripts/generate-api.mjs",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:cycles": "node scripts/verify-cycles.mjs",
    "validate:environments": "node scripts/validate-environments.mjs",
    "export": "expo export --platform android --output-dir dist",
    "quality": "npm run doctor && npm run lint && npm run typecheck && npm test && npm run verify:contract && npm run generate:api && npm run verify:boundaries && npm run verify:cycles && npm run validate:environments && npm run export",
    "e2e": "maestro test e2e/maestro"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "private": true
