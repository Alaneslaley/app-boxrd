{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "APP_ENV": "staging",
        "APP_VERSION": "0.2.0",
        "APP_BUILD": "preview",
        "APP_COMMIT": "eas",
        "EXPO_PUBLIC_API_URL": "https://box-rd-backend.onrender.com",
        "EXPO_PUBLIC_ENABLE_DEMO_SESSION": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  }
}
